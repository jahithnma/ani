# Copy to .env and fill in. Only EXPO_PUBLIC_* values are bundled into the app.

# RevenueCat public SDK keys (Project settings → API keys)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Free key from https://www.pexels.com/api/ (adds real HD/4K photos to feeds)
EXPO_PUBLIC_PEXELS_API_KEY=

# Optional: register at https://auth.pollinations.ai for higher AI limits
EXPO_PUBLIC_POLLINATIONS_REFERRER=wallpaper8k-app
EXPO_PUBLIC_POLLINATIONS_TOKEN=

# Optional: where /wallpapers is hosted (defaults to this GitHub repo, main branch)
# EXPO_PUBLIC_ASSET_BASE_URL=https://cdn.example.com/wallpapers
